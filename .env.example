# ---------------------------------------
# Talentra - Environment Variables
# Copy this file to .env and fill in real values
# ---------------------------------------

# Node environment: development | production
NODE_ENV=production

# Port the Express server listens on (Render sets this automatically,
# but keep default for local/docker-compose use)
PORT=3000

# MongoDB connection string
# Local docker-compose: mongodb://mongo:27017/talentra
# Production (MongoDB Atlas): mongodb+srv://<user>:<password>@<cluster-url>/talentra?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/talentra

# Allowed CORS origin for the frontend (set to your deployed client URL)
CORS_ORIGIN=https://your-app.onrender.com

# Optional: JWT secret if auth is implemented in server/
# JWT_SECRET=replace_with_a_long_random_secret

# Optional: Session secret if using express-session
# SESSION_SECRET=replace_with_a_long_random_secret